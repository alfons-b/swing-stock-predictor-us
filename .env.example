# Salin ke .env untuk development lokal. JANGAN commit .env (sudah di .gitignore).
# Production: isi nilai-nilai ini sebagai GitHub Secrets / Variables, bukan file.

APP_ENV=development
# Development: SQLite lokal.
DATABASE_URL=sqlite:///data/local.db
# Production: database PostgreSQL TERPISAH di Aiven (BUKAN Neon/Supabase yang dipakai proyek lain — keduanya
# ditolak di APP_ENV=production). Ambil dari Aiven Console → service → Overview → Connection information → Service URI.
# DATABASE_URL=postgres://avnadmin:<password>@pg-<nama>-<project>.<x>.aivencloud.com:<port>/defaultdb?sslmode=require
# Batas ukuran: default otomatis dari provider (Aiven 800 MB efektif dari 1 GB disk). Isi angka (MB) hanya setelah upgrade.
# DB_SIZE_LIMIT_MB=

# Penyimpanan model/report: auto = tabel database bila DATABASE_URL PostgreSQL, folder lokal bila SQLite.
MODEL_STORAGE=auto
REPORT_STORAGE=auto

# Provider data
YAHOO_ENABLED=true
CSV_DATA_DIR=data/raw/sample

# Fundamental SEC EDGAR (gratis): SEC mewajibkan User-Agent berisi nama & email Anda.
SEC_USER_AGENT="Nama Anda email@domain.com"

# Riset (opsional, semua boleh kosong — modul memberi label UNAVAILABLE/INSUFFICIENT_DATA)
FUNDAMENTAL_CSV_DIR=data/raw/fundamentals
FOREIGN_FLOW_CSV_DIR=data/raw/foreign_flow_csv
FOREIGN_FLOW_API_URL=
FOREIGN_FLOW_API_KEY=
FX_FILE=data/raw/fx/fx_rates.csv

PORTFOLIO_VALUE=10000
LOG_LEVEL=INFO

# Notifikasi opsional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
